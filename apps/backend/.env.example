NODE_ENV=development

# Local: postgresql://user:pass@localhost:5433/dbname?schema=public
# Production (Neon): postgresql://user:pass@ep-xxx.neon.tech/dbname?sslmode=require
DATABASE_URL="postgresql://merchanic:merchanic@localhost:5433/merchanic?schema=public"

PORT=3000

# สร้าง secret แบบสุ่มสำหรับ production: openssl rand -hex 32
JWT_SECRET=change-me

# URL ของ frontend (สำหรับ CORS)
FRONTEND_URL=http://localhost:5173

# Cloudflare R2 — สร้าง bucket + API token ที่ dash.cloudflare.com → R2
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key
R2_BUCKET_NAME=merchanic
# Public Development URL จากหน้า bucket → Settings → Public Development URL
R2_PUBLIC_URL=https://pub-xxxx.r2.dev
