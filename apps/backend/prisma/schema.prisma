generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  SALES
}

enum QuoteStatus {
  NEW
  REVIEWING
  ADJUSTED
  QUOTED
  CLOSED
}

// ─── Models ──────────────────────────────────────────────────────────────────

model Category {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products   Product[]
  portfolios Portfolio[]
}

model Product {
  id          String   @id @default(uuid())
  categoryId  String
  name        String
  description String
  unitPrice   Decimal  @db.Decimal(12, 2)
  unit        String
  imageKey    String?
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category          Category           @relation(fields: [categoryId], references: [id])
  quoteRequestItems QuoteRequestItem[]
}

model Portfolio {
  id               String   @id @default(uuid())
  title            String
  description      String
  imageKey         String?
  relatedServiceId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  relatedService Category? @relation(fields: [relatedServiceId], references: [id])
}

model StaffUser {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         Role
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignedQuotes QuoteRequest[]
}

model QuoteRequest {
  id             String      @id @default(uuid())
  customerName   String
  company        String?
  email          String
  phone          String
  message        String?
  status         QuoteStatus @default(NEW)
  assignedToId   String?
  autoTotal      Decimal     @db.Decimal(12, 2)
  taxRate        Decimal     @default(7.00) @db.Decimal(5, 2)
  discountAmount Decimal     @default(0.00) @db.Decimal(12, 2)
  finalTotal     Decimal     @db.Decimal(12, 2)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  assignedTo     StaffUser?         @relation(fields: [assignedToId], references: [id])
  items          QuoteRequestItem[]
  quoteDocuments QuoteDocument[]
}

model QuoteRequestItem {
  id                  String   @id @default(uuid())
  quoteRequestId      String
  productId           String
  quantity            Int
  unitPriceSnapshot   Decimal  @db.Decimal(12, 2)
  adjustedUnitPrice   Decimal? @db.Decimal(12, 2)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  quoteRequest QuoteRequest @relation(fields: [quoteRequestId], references: [id])
  product      Product      @relation(fields: [productId], references: [id])
}

model QuoteDocument {
  id             String   @id @default(uuid())
  quoteRequestId String
  documentNumber String   @unique
  subtotal       Decimal  @db.Decimal(12, 2)
  taxAmount      Decimal  @db.Decimal(12, 2)
  discountAmount Decimal  @db.Decimal(12, 2)
  grandTotal     Decimal  @db.Decimal(12, 2)
  pdfKey         String?
  issuedAt       DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  quoteRequest QuoteRequest @relation(fields: [quoteRequestId], references: [id])
}
